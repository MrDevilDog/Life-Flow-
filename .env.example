# 🩸 Blood Donation App - Environment Configuration Example

# 🗄️ Database
# Format: postgresql://[user]:[password]@[host]:5432/[database]?sslmode=require
# Recommended: Get this from your Neon.tech dashboard
DATABASE_URL=postgresql://user:password@host:5432/neondb?sslmode=require

# 🔐 Authentication
# Replace with a long random string (at least 32 characters)
JWT_SECRET=replace_this_with_a_secure_random_string
JWT_ISSUER=blood-donation-app
JWT_EXPIRES_IN=7d

# 📧 Email (Nodemailer)
# Gmail: use an App Password, not your account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# 🌍 App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ⚙️ Node Environment
NODE_ENV=development

